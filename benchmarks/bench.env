# Throwaway values for the local benchmark stack only. Nothing here is a real secret.
APP_DOMAIN=bench.seentics.test
STORAGE_DOMAIN=storage.bench.seentics.test
CADDY_IMAGE=caddy:2.8-alpine
# Postgres 16 with `hll`, built from deploy/postgres — the rollups are what is measured.
POSTGRES_IMAGE=seentics-postgres:16-hll
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_MC_IMAGE=quay.io/minio/minio:latest

POSTGRES_USER=seentics
POSTGRES_PASSWORD=bench_postgres_password
POSTGRES_DB=seentics
DATABASE_URL=postgres://seentics:bench_postgres_password@postgres:5432/seentics?sslmode=disable

JWT_SECRET=bench-jwt-secret-0123456789abcdef0123456789abcdef0123456789abcdef
GLOBAL_API_KEY=bench-global-api-key-0123456789abcdef0123456789abcdef0123456789

MINIO_ROOT_USER=benchminio
MINIO_ROOT_PASSWORD=benchminio-secret
S3_BUCKET_REPLAYS=seentics-replays
AWS_REGION=us-east-1
