{
  "name": "@seentics/ui",
  "version": "0.1.0",
  "description": "Reusable UI blocks for Seentics analytics — drop-in React components for traffic, heatmaps, replays, funnels",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.400.0",
    "recharts": "^2.12.0",
    "rrweb-player": "^1.0.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-css-injected-by-js": "^3.5.0",
    "vite-plugin-dts": "^3.0.0"
  },
  "keywords": ["seentics", "analytics", "observability", "ui", "components", "react"],
  "license": "MIT"
}
