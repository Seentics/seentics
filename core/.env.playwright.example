# Playwright Screenshot System Configuration
# Copy to .env.local and customize for your environment

# === S3/MinIO Storage Configuration ===
# These use existing S3 config from your main environment

# For AWS S3
S3_BUCKET=seentics-replays
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# For MinIO (local development)
# S3_BUCKET=seentics-replays
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# === Screenshot Cache Configuration ===
# In-memory cache for screenshot lookups (avoids DB/browser on repeated requests)

# Enable caching (default: true)
SCREENSHOT_CACHE_ENABLED=true

# Cache TTL in milliseconds (default: 3600000 = 1 hour)
# Examples:
# 30 minutes:  1800000
# 1 hour:      3600000 (default)
# 4 hours:     14400000
# 24 hours:    86400000
SCREENSHOT_CACHE_TTL_MS=3600000

# Maximum cached entries (default: 1000)
# Each entry ~200 bytes, so 1000 = ~200KB memory
SCREENSHOT_CACHE_MAX_ENTRIES=1000

# === Browser Configuration ===
# Currently hardcoded to 5, but can be made configurable via env var

# Maximum concurrent browser pages for screenshots
# PLAYWRIGHT_BROWSER_POOL_SIZE=5

# Browser launch timeout (milliseconds)
# PLAYWRIGHT_BROWSER_LAUNCH_TIMEOUT=30000

# === Proxy Configuration (if needed) ===
# For capturing pages through a corporate proxy:
# PLAYWRIGHT_HTTP_PROXY=http://proxy.company.com:8080
# PLAYWRIGHT_HTTPS_PROXY=http://proxy.company.com:8080

# === Debug Configuration ===
# Enable debug logging (verbose)
# DEBUG=playwright:*
