# Copy outside the repository, set the values in your secret manager, and pass the
# resulting file with --env-file. Do not commit the real file.
APP_DOMAIN=analytics.example.com
STORAGE_DOMAIN=storage.analytics.example.com
ACME_EMAIL=ops@example.com

# Use immutable image digests in real deployments, not floating tags.
CADDY_IMAGE=caddy:2.8-alpine
# Postgres with the `hll` extension turns on the dashboard's analytics rollups (fast
# reports at any traffic level). Build it once from deploy/postgres:
#   docker build -t seentics-postgres:16-hll deploy/postgres
# A plain postgres image also works — core then reads raw events, which slows down on
# large sites. Do not point an existing Alpine data volume at the Debian-based hll image;
# restore a dump into a fresh volume instead.
POSTGRES_IMAGE=seentics-postgres:16-hll
OBJEX_IMAGE=ghcr.io/kajdesk/objex:0.2.0
AWS_CLI_IMAGE=amazon/aws-cli:2.27.0

POSTGRES_USER=seentics
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=seentics
DATABASE_URL=postgres://seentics:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/seentics?sslmode=disable

# Generate independently, for example: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_UNIQUE_64_CHARACTER_OR_LONGER_SECRET
GLOBAL_API_KEY=REPLACE_WITH_A_UNIQUE_64_CHARACTER_OR_LONGER_SECRET

# objex object storage — the key objex starts with and the API signs with.
# For example: echo "OBX$(openssl rand -hex 8)" and openssl rand -base64 48
OBJEX_ACCESS_KEY=REPLACE_WITH_AN_ACCESS_KEY
OBJEX_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
S3_BUCKET_REPLAYS=seentics-replays
NEXT_PUBLIC_IS_ENTERPRISE=false
